# Password gate. Leave empty to make the site public.
# Checked on the server only — never prefix it with PUBLIC_ (that ships it to the browser).
SITE_GATE_PASSWORD=

# Google Sheets via the workbook's Apps Script web app (see README → "Google Sheets via Apps Script").
# APPS_SCRIPT_URL ends in /exec. APPS_SCRIPT_SECRET must match the SITE_SECRET script property.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Code for the /admin page (confirm asoebi & groomsmen responses, see the guest list).
# Leave empty to turn the admin page off. Use something long and different from the site password.
ADMIN_CODE=

# Telegram alerts for new RSVPs and asoebi / groomsmen sign-ups (see README → "Telegram alerts").
# Leave either empty to turn alerts off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
