---
import "@/styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PageLoader from "@/components/loader/PageLoader.astro";
import type { LoaderConfig } from "@/components/loader/loaderConfig";
import { coupleNames } from "@/config/event";

interface Props {
  title: string;
  description?: string;
  canonicalHref?: string;
  ogTitle?: string;
  /** Link-preview image (1200×630 JPEG in public/); the couple photo when omitted. */
  ogImage?: { src: string; alt: string };
  ogDescription?: string;
  ogUrl?: string;
  htmlClass?: string;
  bodyClass?: string;
  /** Full-screen loader for this page (see PageLoader); none when omitted. */
  loader?: LoaderConfig;
}

const {
  title,
  description,
  canonicalHref = Astro.url.href,
  ogTitle,
  ogDescription,
  ogUrl = canonicalHref,
  ogImage: ogImageProp = { src: "/og.jpg", alt: coupleNames },
  htmlClass,
  bodyClass,
  loader,
} = Astro.props;

const loaderPhoto = loader && loader.kind !== "seal" ? loader.photo : null;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
// Absolute, as link previews (WhatsApp, iMessage) require; a JPEG for the same reason.
// From the address being served, so preview deployments show their own image.
const ogImage = new URL(ogImageProp.src, Astro.url.origin).href;
---

<!doctype html>
<html lang="en" class:list={[htmlClass]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f6f1ea" />
    <!-- No maximum-scale: guests must be able to pinch-zoom. Form fields use
         16px+ text, so iOS doesn't zoom in when one is tapped. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="canonical" href={canonicalHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={coupleNames} />
    <meta property="og:title" content={resolvedOgTitle} />
    {resolvedOgDescription ? <meta property="og:description" content={resolvedOgDescription} /> : null}
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageProp.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caudex:ital,wght@0,400;0,700;1,400;1,700&family=Manrope:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    {loaderPhoto ? <link rel="preload" as="image" href={loaderPhoto} fetchpriority="high" /> : null}
    <slot name="head" />
    <Analytics />
  </head>
  <script>
    import { initScrollReveal } from "@/lib/scrollReveal";
    initScrollReveal();
  </script>
  <body class:list={[bodyClass]}>
    {loader ? <PageLoader loader={loader} /> : null}
    <Header />
    <div class="site-shell">
      <slot />
    </div>
    <Footer />
  </body>
</html>
