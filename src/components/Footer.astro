---
import { event } from "@/config/event";
import { navItems, siteTitleSuffix } from "@/data/site-nav";

const year = new Date(event.countdownTarget).getFullYear();
const brandLead = siteTitleSuffix[0];
const brandMiddle = siteTitleSuffix.slice(1);
const secondInitial = event.partnerTwo.firstName[0];
const { countdownTarget, countdownLabel } = event;
const footerNavLinks = navItems.filter((n) => n.target === "_self")
---

<footer class="site-footer" aria-label="Site">
  <div class="site-footer__inner">
    <nav class="site-footer__nav" aria-label="Footer navigation">
      {
        footerNavLinks.map((link) => (
          <a class="site-footer__nav-link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="site-footer__brand" aria-label={siteTitleSuffix}>
      <span class="site-footer__brand-stage">
        <span class="site-footer__brand-row">
          <span class="site-footer__brand-lead">{brandLead}</span>
          <span
            class="site-footer__brand-segment site-footer__brand-segment--full"
            >{brandMiddle}</span
          >
          <span
            class="site-footer__brand-segment site-footer__brand-segment--initials"
            aria-hidden="true"
          >
            &#x2665;&#xFE0E;{secondInitial}
          </span>
        </span>
      </span>
    </p>

    <p
      class="site-footer__countdown"
      aria-live="polite"
      data-target={countdownTarget}
      data-label={countdownLabel}
    ></p>

    <p class="site-footer__meta">&copy; {year} · With love</p>
  </div>
</footer>

<style>
  .site-footer {
    --footer-tan: #e8d5b8;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 0;
    height: var(--site-footer-reveal);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* Top padding clears the page's rounded edge that overlaps the footer */
    padding: calc(2rem + var(--footer-overlap)) 1.5rem
      calc(1.75rem + env(safe-area-inset-bottom, 0px));
    color: var(--footer-tan);
    /* Same treatment as the home hero: an even dark tint plus extra shade
       behind the centred text so it stays readable over the photo */
    --footer-scrim:
      radial-gradient(
        ellipse 60% 50% at 50% 55%,
        rgb(20 12 6 / 0.4) 0%,
        rgb(20 12 6 / 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(20 12 6 / 0.42) 0%,
        rgb(20 12 6 / 0.5) 50%,
        rgb(20 12 6 / 0.7) 100%
      );
    background-image:
      var(--footer-scrim),
      url("/assets/for-footer.webp");
    background-size: cover;
    /* Portrait photo in a wide strip: aim the visible slice at the couple's faces */
    background-position: center 25%;
    background-repeat: no-repeat;
    box-shadow: 0 -20px 60px -8px rgb(18 10 4 / 0.35);
  }

  /*
   * Desktop: the footer is too wide for a portrait photo to cover it and still
   * show both faces. Scale the photo to the footer height instead (faces in the
   * top ~60%, above the text), centre it, and fill the sides with a blurred copy.
   * Photo aspect is 853×1280, so at 170% height it is ~1.13 × the footer height wide.
   */
  @media (min-width: 768px) {
    .site-footer {
      --footer-photo-half: calc(var(--site-footer-reveal) * 0.566);
      isolation: isolate;
      background: #2b2420;
    }

    .site-footer::before,
    .site-footer::after {
      content: "";
      position: absolute;
      z-index: -1;
      pointer-events: none;
    }

    /* Blurred fill for the sides */
    .site-footer::before {
      inset: -3rem;
      background: url("/assets/for-footer.webp") center 30% / cover no-repeat;
      filter: blur(32px) brightness(0.6) saturate(0.9);
    }

    /* Sharp photo, edges faded into the blurred fill */
    .site-footer::after {
      inset: 0;
      background:
        var(--footer-scrim),
        url("/assets/for-footer.webp") center 24% / auto 170% no-repeat;
      --fade-start: calc(50% - var(--footer-photo-half));
      --fade-end: calc(50% - var(--footer-photo-half) * 0.7);
      -webkit-mask-image: linear-gradient(
        to right,
        transparent var(--fade-start),
        #000 var(--fade-end),
        #000 calc(100% - var(--fade-end)),
        transparent calc(100% - var(--fade-start))
      );
      mask-image: linear-gradient(
        to right,
        transparent var(--fade-start),
        #000 var(--fade-end),
        #000 calc(100% - var(--fade-end)),
        transparent calc(100% - var(--fade-start))
      );
    }
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: min(100%, 60rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* Nav */

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.1rem 1.5rem;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .site-footer__nav-link {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(232 213 184 / 0.65);
    text-decoration: none;
    transition: color 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__nav-link:hover {
      color: rgb(232 213 184 / 1);
    }
  }

  /* Brand */

  .site-footer__brand {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding-inline: 0.75rem;
    text-align: center;
  }

  .site-footer__brand-stage {
    --brand-cycle: 6s;
    --brand-stage-width: 20rem;
    --brand-full-width: 18rem;
    --brand-initials-width: 4rem;
    position: relative;
    display: block;
    width: var(--brand-stage-width);
    max-width: 100%;
    height: 1.2em;
    font-family: var(--font-heading);
    /* Min size keeps "First & First" within a ~360px phone */
    font-size: clamp(2.1rem, 8vw, 6.5rem);
    line-height: 1.2;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .site-footer__brand-row {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  .site-footer__brand-segment {
    overflow: hidden;
    max-width: 0;
    animation-duration: var(--brand-cycle);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    /* The footer sits under every page; only animate while it's on screen,
       since max-width changes need a layout pass each frame. */
    animation-play-state: paused;
  }

  .site-footer__inner--revealed .site-footer__brand-segment {
    animation-play-state: running;
  }

  .site-footer__brand-segment--full {
    animation-name: site-footer-brand-full;
  }

  .site-footer__brand-segment--initials {
    animation-name: site-footer-brand-initials;
  }

  @keyframes site-footer-brand-full {
    0%,
    22%,
    78%,
    100% {
      max-width: var(--brand-full-width);
    }
    34%,
    66% {
      max-width: 0;
    }
  }

  @keyframes site-footer-brand-initials {
    0%,
    22%,
    78%,
    100% {
      max-width: 0;
    }
    34%,
    66% {
      max-width: var(--brand-initials-width);
    }
  }

  /* Countdown */

  .site-footer__countdown {
    margin: clamp(0.65rem, 2vh, 1rem) 0 0;
    font-size: clamp(0.72rem, 1.8vw, 0.9rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgb(232 213 184 / 0.65);
    text-align: center;
    min-height: 1.4em;
  }

  /* Meta */

  .site-footer__meta {
    margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgb(232 213 184 / 0.4);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__brand-segment--full {
      max-width: var(--brand-full-width);
      animation: none;
    }

    .site-footer__brand-segment--initials {
      display: none;
    }
  }
</style>

<script>
  function measureUnclippedWidth(el: HTMLElement) {
    const previousAnimation = el.style.animation;
    const previousMaxWidth = el.style.maxWidth;
    el.style.animation = "none";
    el.style.maxWidth = "none";
    const width = Math.ceil(el.getBoundingClientRect().width);
    el.style.maxWidth = previousMaxWidth;
    el.style.animation = previousAnimation;
    return width;
  }

  function measureBrandStage(stage: HTMLElement) {
    const lead = stage.querySelector(".site-footer__brand-lead");
    const full = stage.querySelector(".site-footer__brand-segment--full");
    const initials = stage.querySelector(
      ".site-footer__brand-segment--initials",
    );
    if (
      !(lead instanceof HTMLElement) ||
      !(full instanceof HTMLElement) ||
      !(initials instanceof HTMLElement)
    ) {
      return;
    }

    const leadWidth = measureUnclippedWidth(lead);
    const fullWidth = measureUnclippedWidth(full);
    const initialsWidth = measureUnclippedWidth(initials);

    stage.style.setProperty("--brand-full-width", `${fullWidth}px`);
    stage.style.setProperty("--brand-initials-width", `${initialsWidth}px`);
    stage.style.setProperty(
      "--brand-stage-width",
      `${Math.ceil(leadWidth + Math.max(fullWidth, initialsWidth))}px`,
    );
  }

  function updateCountdown(el: HTMLElement) {
    const wedding = new Date(el.dataset.target ?? "");
    const label = el.dataset.label ?? "";
    if (Number.isNaN(wedding.getTime())) return;
    const now = new Date();
    const msLeft = wedding.getTime() - now.getTime();
    const days = Math.max(0, Math.ceil(msLeft / 86400000));

    if (days === 0) {
      el.textContent = `Today · ${label}`;
    } else if (days === 1) {
      el.textContent = `Tomorrow · ${label}`;
    } else {
      el.textContent = `${days.toLocaleString()} days · ${label}`;
    }
  }

  function initFooter() {
    const footer = document.querySelector(".site-footer");
    const shell = document.querySelector(".site-shell");
    if (!(footer instanceof HTMLElement) || !(shell instanceof HTMLElement))
      return;

    const inner = footer.querySelector<HTMLElement>(".site-footer__inner");
    const stage = footer.querySelector<HTMLElement>(
      ".site-footer__brand-stage",
    );
    const countdown = footer.querySelector<HTMLElement>(
      ".site-footer__countdown",
    );

    if (!inner || !stage) return;

    let revealed = false;
    let resizeFrame = 0;
    let scrollFrame = 0;

    const queueMeasure = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        measureBrandStage(stage);
      });
    };

    const updateReveal = () => {
      const shellBottom = shell.getBoundingClientRect().bottom;
      const innerTop = window.innerHeight - inner.offsetHeight;
      const isRevealed = shellBottom <= innerTop + 40;
      if (isRevealed === revealed) return;
      revealed = isRevealed;
      inner.classList.toggle("site-footer__inner--revealed", revealed);
    };

    // At most one measurement per frame, however fast scroll events arrive.
    const onScroll = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        updateReveal();
      });
    };

    const onResize = () => {
      queueMeasure();
      onScroll();
    };

    if (countdown) updateCountdown(countdown);

    void document.fonts.ready.then(queueMeasure);
    queueMeasure();
    updateReveal();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFooter, { once: true });
  } else {
    initFooter();
  }
</script>
