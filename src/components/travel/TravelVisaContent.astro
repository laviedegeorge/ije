---
import ContentCard from "@/components/ContentCard.astro";
import { travelVisaPage } from "@/data/travel-visa";

const { hero, basics, applyCard } = travelVisaPage;

const externalRel = "noopener noreferrer";
---

<ContentCard variant="primary" class="travel-visa__apply-card">
	<div data-reveal>
		<h2 id="travel-visa-section-title" class="travel-visa__page-title">
			{hero.title}
		</h2>
		{
			hero.ledes.map((lede) => <p class="travel-visa__page-lede copy-preserve-breaks">{lede}</p>)
		}
	</div>

	<p class="travel-visa__apply-title">{applyCard.title}</p>
	<p class="travel-visa__apply-copy copy-preserve-breaks">{applyCard.copy}</p>
	<div class="travel-visa__actions">
		{
			applyCard.links.map((link) => (
				<a
					class:list={[
						"travel-visa__btn",
						link.variant === "primary"
							? "travel-visa__btn--primary"
							: "travel-visa__btn--secondary",
					]}
					href={link.href}
					target="_blank"
					rel={externalRel}
				>
					{link.label}
				</a>
			))
		}
	</div>

	<ContentCard variant="secondary" class="travel-visa__main-shell">
		<h2 class="travel-visa__section-title">{basics.title}</h2>
		<p class="travel-visa__section-lede copy-preserve-breaks">{basics.lede}</p>
		<ul class="travel-visa__checklist" data-visa-checklist>
			{
				basics.points.map((point, index) => (
					<li
						class="travel-visa__checklist-item"
						data-reveal
						data-delay={String((index % 4) + 1)}
					>
						<label class="travel-visa__check-label">
							<input
								class="travel-visa__check-input"
								type="checkbox"
								data-visa-item={index}
							/>
							<span class="travel-visa__check-mark" aria-hidden="true"></span>
							<span class="travel-visa__check-text">{point}</span>
						</label>
					</li>
				))
			}
		</ul>
		<button class="travel-visa__reset" data-visa-reset type="button">
			Reset checklist
		</button>
	</ContentCard>
</ContentCard>

<style>
	.travel-visa__page-title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.travel-visa__page-lede {
		margin: 0 0 var(--travel-block-gap);
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.travel-visa__page-lede:last-of-type {
		margin-bottom: var(--travel-block-gap);
	}

	:global(.travel-visa__main-shell) {
		width: 100%;
		border-color: rgb(110 82 60 / 0.12);
		background: rgb(255 255 255 / 0.32);
		box-shadow: 0 16px 48px rgb(110 82 60 / 0.1);
		padding: clamp(1rem, 2.4vw, 1.4rem);
	}

	.travel-visa__section-title {
		margin: 0;
		font-size: clamp(1.2rem, 2.4vw, 1.45rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text-primary);
	}

	.travel-visa__section-lede {
		margin: 0.65rem 0 0.95rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	/* Checklist */

	.travel-visa__checklist {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.6rem;
	}

	.travel-visa__checklist-item {
		margin: 0;
		border-radius: 0.75rem;
		background: rgb(255 255 255 / 0.36);
		border: 1px solid rgb(110 82 60 / 0.16);
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			opacity 0.2s ease;
	}

	/* Interactive checkbox label */

	.travel-visa__check-label {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 0.7rem 0.85rem;
		cursor: pointer;
		-webkit-user-select: none;
		user-select: none;
	}

	/* Visually-hidden native input (still in tab order & accessible) */
	.travel-visa__check-input {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	/* Custom check icon — circular badge with ✓ symbol */
	.travel-visa__check-mark {
		flex-shrink: 0;
		width: 1.375rem;
		height: 1.375rem;
		margin-top: 0.05rem;
		border-radius: 50%;
		border: 1.5px solid rgb(110 82 60 / 0.28);
		background: transparent;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.6875rem;
		font-weight: 700;
		color: rgb(110 82 60 / 0.3);
		transition:
			background 0.18s ease,
			border-color 0.18s ease,
			color 0.18s ease;
	}

	.travel-visa__check-mark::after {
		content: "✓";
	}

	/* Text */
	.travel-visa__check-text {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--text-primary);
		transition:
			opacity 0.2s ease,
			text-decoration-color 0.2s ease;
		text-decoration: line-through;
		text-decoration-color: transparent;
	}

	/* Checked state */
	.travel-visa__checklist-item:has(.travel-visa__check-input:checked) {
		background: rgb(255 255 255 / 0.2);
		border-color: rgb(110 82 60 / 0.1);
	}

	.travel-visa__checklist-item:has(.travel-visa__check-input:checked) .travel-visa__check-mark {
		background: #6e523c;
		border-color: #6e523c;
		color: #fff;
	}

	.travel-visa__checklist-item:has(.travel-visa__check-input:checked) .travel-visa__check-text {
		opacity: 0.5;
		text-decoration-color: currentColor;
	}

	/* Focus ring on the label via the hidden input */
	.travel-visa__check-input:focus-visible + .travel-visa__check-mark {
		outline: 2px solid #6e523c;
		outline-offset: 2px;
	}

	/* Hover */
	@media (hover: hover) and (pointer: fine) {
		.travel-visa__check-label:hover .travel-visa__check-mark {
			border-color: rgb(110 82 60 / 0.55);
			color: rgb(110 82 60 / 0.55);
		}
	}

	/* Reset button — hidden until [data-has-checks] is set on the checklist */

	.travel-visa__reset {
		display: block;
		margin: 0.75rem auto 0;
		padding: 0;
		border: none;
		background: none;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(92 74 61 / 0.55);
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			color 0.15s ease;
	}

	.travel-visa__checklist[data-has-checks] ~ .travel-visa__reset {
		opacity: 1;
		pointer-events: auto;
	}

	@media (hover: hover) and (pointer: fine) {
		.travel-visa__reset:hover {
			color: #6e523c;
		}
	}

	/* Apply card */

	.travel-visa__apply-card {
		margin-top: 0;
	}

	.travel-visa__apply-title {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		font-weight: 600;
		color: var(--text-primary);
	}

	.travel-visa__apply-copy {
		margin: 0.65rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.travel-visa__actions {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.travel-visa__btn {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 0.72rem 0.95rem;
		border-radius: 0.7rem;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		border: 1px solid transparent;
		box-shadow: 0 4px 14px rgb(78 59 44 / 0.12);
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.travel-visa__btn::after {
		content: "↗";
		font-size: 0.95em;
		line-height: 1;
		opacity: 0.9;
	}

	.travel-visa__btn--primary {
		background: #6e523c;
		border-color: #6e523c;
		color: #fff;
	}

	.travel-visa__btn--primary:hover {
		background: #5e4734;
		transform: translateY(-1px);
		box-shadow: 0 8px 20px rgb(78 59 44 / 0.24);
	}

	.travel-visa__btn--secondary {
		background: rgb(255 255 255 / 0.88);
		border-color: rgb(110 82 60 / 0.35);
		color: #4e3b2c;
	}

	.travel-visa__btn--secondary:hover {
		background: #fff;
		transform: translateY(-1px);
		box-shadow: 0 8px 20px rgb(78 59 44 / 0.2);
	}

	.travel-visa__btn:focus-visible {
		outline: 2px solid #4e3b2c;
		outline-offset: 2px;
	}

	@media (max-width: 899px) {
		:global(.travel-visa__main-shell) {
			border-radius: clamp(1.35rem, 5vw, 2rem);
		}
	}

	@media (min-width: 768px) {
		.travel-visa__page-lede,
		.travel-visa__section-lede,
		.travel-visa__apply-copy {
			font-size: 1rem;
		}
	}
</style>

<script>
	const STORAGE_KEY = "visa-checklist";

	function initVisaChecklist() {
		const checklist = document.querySelector<HTMLElement>("[data-visa-checklist]");
		const resetBtn = document.querySelector<HTMLButtonElement>("[data-visa-reset]");
		if (!checklist) return;

		const inputs = [
			...checklist.querySelectorAll<HTMLInputElement>("[data-visa-item]"),
		];

		// Read stored state and restore
		let stored: boolean[] = [];
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw) stored = JSON.parse(raw);
		} catch (_) {
			// localStorage unavailable (private mode, etc.)
		}

		inputs.forEach((input, i) => {
			if (stored[i]) input.checked = true;
		});

		const syncState = () => {
			const state = inputs.map((inp) => inp.checked);
			const hasAny = state.some(Boolean);

			try {
				if (hasAny) {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
				} else {
					localStorage.removeItem(STORAGE_KEY);
				}
			} catch (_) {}

			if (hasAny) {
				checklist.dataset.hasChecks = "";
			} else {
				delete checklist.dataset.hasChecks;
			}
		};

		// Restore [data-has-checks] on load if any items are already checked
		syncState();

		inputs.forEach((input) => {
			input.addEventListener("change", syncState);
		});

		resetBtn?.addEventListener("click", () => {
			inputs.forEach((inp) => {
				inp.checked = false;
			});
			syncState();
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initVisaChecklist, { once: true });
	} else {
		initVisaChecklist();
	}
</script>
