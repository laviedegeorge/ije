---
interface Props {
	bgSrc?: string;
	surfaceClass?: string;
	ariaLabelledBy?: string;
}

const { bgSrc, surfaceClass, ariaLabelledBy } = Astro.props;
---

<section
	class:list={[
		"hero-page",
		surfaceClass,
	]}
	aria-labelledby={ariaLabelledBy}
>
	<div
		class="hero-page__bg"
		aria-hidden="true"
		style={`--hero-bg:${bgSrc ? `url('${bgSrc}')` : "none"}`}
	>
	</div>
	<div class="hero-page__scrim" aria-hidden="true"></div>

	<div class="hero-page__shell wrapper">
		<slot />
	</div>
</section>

<style>
	.hero-page {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		/* Keeps the fixed photo layer below inside this section. */
		clip-path: inset(0);
		min-height: 100vh;
		min-height: 100dvh;
		font-family: var(--font-body);
		color: var(--text-primary);
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	/*
	 * The photo stays put while the page scrolls. A fixed layer does that on the
	 * GPU; `background-attachment: fixed` repaints on every scroll frame on
	 * Android and is ignored on iOS, which then zooms the photo across the page.
	 */
	.hero-page__bg {
		position: fixed;
		inset: 0 0 auto;
		height: 100vh;
		/* The tallest viewport, so the photo doesn't jump as the browser bar hides. */
		height: 100lvh;
		z-index: 0;
		background-image:
			var(--hero-bg),
			linear-gradient(
				168deg,
				#eceae6 0%,
				var(--page-bg-mid) 52%,
				#ebe7e1 100%
			);
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
		pointer-events: none;
	}

	.hero-page__scrim {
		position: absolute;
		inset: 0;
		z-index: 0;
		background:
			radial-gradient(
				ellipse 92% 78% at 8% 6%,
				var(--page-tan-glow),
				transparent 54%
			),
			radial-gradient(
				ellipse 88% 72% at 96% 94%,
				var(--page-tan-deep),
				transparent 58%
			),
			radial-gradient(
				ellipse 80% 72% at 50% -10%,
				rgb(233 231 228 / 0.45),
				transparent 58%
			),
			linear-gradient(
				180deg,
				rgb(245 239 229 / 0.35) 0%,
				rgb(233 229 223 / 0.72) 48%,
				rgb(233 229 223 / 0.88) 100%
			);
		pointer-events: none;
	}

	.hero-page__shell {
		position: relative;
		z-index: 1;
		padding-top: max(
			4rem,
			calc(
				var(--site-header-height) + env(safe-area-inset-top, 0px) +
					4.5rem
			)
		);
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	@media (min-width: 1024px) {
		.hero-page__shell {
			padding-top: max(
				4.25rem,
				calc(
					var(--site-header-height) + env(safe-area-inset-top, 0px) +
						5rem
				)
			);
		}
	}
</style>
