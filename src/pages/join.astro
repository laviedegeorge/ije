---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import InterestPage from "@/components/interest/InterestPage.astro";
import { coupleNames, event } from "@/config/event";
import { joinPageContent } from "@/data/interestPages";
import { invitePreviewImage } from "@/data/shareInvite";
import { siteTitleSuffix } from "@/data/site-nav";
import { resolveInvitee } from "@/util/inviteList";
import { findResponseByCode } from "@/util/interestSheet";

// Personal links look like ?n=ada&c=K7Q2M9 — the code grants access, the name personalises.
const linkName = Astro.url.searchParams.get("n")?.trim() ?? "";
const linkCode = Astro.url.searchParams.get("c")?.trim() ?? "";
const invitee = await resolveInvitee("join", linkCode, linkName);
// Already registered with this link? The page says so instead of offering the form again.
const existing = invitee ? await findResponseByCode(event.sheets.groomsmen, invitee.code) : null;

const title = `Join the Wedding Train · ${siteTitleSuffix}`;
const description = `Join the wedding train for ${coupleNames}'s wedding.`;
---

<BaseLayout
	title={title}
	description={description}
	ogImage={invitePreviewImage}
	loader={invitee ? { kind: "seal", guestName: invitee.name.split(" ")[0] } : undefined}
>
	<meta slot="head" name="robots" content="noindex" />
	<InterestPage
		content={joinPageContent}
		endpoint="/api/join"
		invitee={invitee}
		existing={existing}
		idPrefix="join"
	/>
</BaseLayout>
