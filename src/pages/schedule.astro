---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ColorsOfTheDay from "@/components/ColorsOfTheDay.astro";
import EventIcon from "@/components/EventIcon.astro";
import { coupleFullNames, event } from "@/config/event";
import { siteTitleSuffix } from "@/data/site-nav";
import { schedulePageData } from "@/data/schedule";

const title = `Schedule · ${siteTitleSuffix}`;
const description = `Ceremony schedule for ${coupleFullNames}, including event dates and venues in ${event.locationLabel}.`;
const canonicalHref = new URL("/schedule", Astro.url.origin).href;
---

<BaseLayout
  loader={{ kind: "curtain", title: "Schedule", photo: "/assets/loaders/schedule.webp" }}
  title={title}
  description={description}
  canonicalHref={canonicalHref}
>
  <main class="schedule-page wrapper" aria-labelledby="schedule-title">
    <header class="schedule-page__header" data-reveal>
      <p class="schedule-page__eyebrow">{schedulePageData.eyebrow}</p>
      <h1 id="schedule-title">{schedulePageData.title}</h1>
    </header>

    <section class="schedule-page__events" aria-label="Event schedule">
      {
        schedulePageData.days.map((day) => (
          <section class="schedule-day" id={day.id}>
            <h2 class="schedule-day__title" data-reveal>{day.dayLabel}</h2>
            <div class="schedule-day__events">
              {day.events.map((event, eventIndex) => (
                <article class="schedule-event-card" data-reveal data-delay={String(Math.min(eventIndex + 1, 4))}>
                  {event.icon ? (
                    <span class="schedule-event-card__icon" aria-hidden="true">
                      <EventIcon type={event.icon} />
                    </span>
                  ) : null}
                  <h3 class="schedule-event-card__title">{event.title}</h3>
                  {event.timeLabel ? (
                    <p class="schedule-event-card__time">{event.timeLabel}</p>
                  ) : null}
                  <p class="schedule-event-card__venue">{event.venue}</p>
                  <p class="schedule-event-card__location">
                    {event.mapHref ? (
                      <a
                        class="schedule-event-card__location-link"
                        href={event.mapHref}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {event.location}
                      </a>
                    ) : (
                      event.location
                    )}
                  </p>
                  {event.colorsOfTheDay ? (
                    <ColorsOfTheDay colors={event.colorsOfTheDay} />
                  ) : null}
                  {event.notes ? (
                    <p class="schedule-event-card__notes copy-preserve-breaks">
                      {event.notes}
                    </p>
                  ) : null}
                  <div class="schedule-event-card__actions">
                    {event.mapHref ? (
                      <a
                        class="schedule-action schedule-action--primary"
                        href={event.mapHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Get directions"
                      >
                        <svg
                          class="schedule-action__icon"
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path
                            d="M12 2c-3.87 0-7 3.13-7 7 0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linejoin="round"
                          />
                          <circle
                            cx="12"
                            cy="9"
                            r="2.4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                          />
                        </svg>
                        <span class="schedule-action__label">Directions</span>
                      </a>
                    ) : null}
                    {event.googleCalendarHref || event.appleCalendarHref ? (
                      <div class="schedule-event-card__calendar">
                        {event.googleCalendarHref ? (
                          <a
                            class="schedule-action"
                            href={event.googleCalendarHref}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Add to Google Calendar"
                          >
                            <svg
                              class="schedule-action__icon"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                            >
                              <rect
                                x="3.5"
                                y="4.5"
                                width="17"
                                height="16"
                                rx="2.4"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                              />
                              <path
                                d="M3.5 9.5h17M8 2.8v3.4M16 2.8v3.4"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                stroke-linecap="round"
                              />
                            </svg>
                            <span class="schedule-action__label">Google</span>
                          </a>
                        ) : null}
                        {event.appleCalendarHref ? (
                          <a
                            class="schedule-action"
                            href={event.appleCalendarHref}
                            download={`${event.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}.ics`}
                            aria-label="Add to Apple Calendar"
                          >
                            <svg
                              class="schedule-action__icon"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                            >
                              <rect
                                x="3.5"
                                y="4.5"
                                width="17"
                                height="16"
                                rx="2.4"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                              />
                              <path
                                d="M3.5 9.5h17M8 2.8v3.4M16 2.8v3.4"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.7"
                                stroke-linecap="round"
                              />
                            </svg>
                            <span class="schedule-action__label">Apple</span>
                          </a>
                        ) : null}
                      </div>
                    ) : null}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .schedule-page {
    padding-top: clamp(6.75rem, 13vw, 10rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: clamp(3.2rem, 8vw, 5rem);
  }

  .schedule-page__header {
    text-align: center;
  }

  .schedule-page__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(92 74 61 / 0.75);
  }

  .schedule-page__header h1 {
    margin: 1.2rem 0 0;
    font-size: clamp(2.1rem, 7vw, 4rem);
    line-height: 0.95;
    color: #3f2e22;
  }

  .schedule-page__events {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4rem);
    width: 100%;
    text-align: center;
  }

  .schedule-day {
    display: grid;
    gap: 1.8rem;
    width: 100%;
    justify-items: center;
    position: relative;
    scroll-margin-top: calc(
      var(--site-header-height) + env(safe-area-inset-top, 0px) + 1rem
    );
  }

  .schedule-day:not(:first-child) {
    padding-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  .schedule-day:not(:first-child)::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 22rem);
    height: 1px;
    background: linear-gradient(
      to right,
      rgb(110 82 60 / 0),
      rgb(110 82 60 / 0.35),
      rgb(110 82 60 / 0)
    );
  }

  .schedule-day__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.05;
    color: #3a2e26;
  }

  /* Self-contained event cards, centered and constrained on every screen */
  .schedule-day__events {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    width: 100%;
  }

  .schedule-event-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(1.95rem, 4vw, 2.5rem) clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 1.25rem;
    width: 100%;
    max-width: 34rem;
    text-align: center;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.55) 0%,
      rgb(255 255 255 / 0.28) 100%
    );
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border: 1px solid rgb(255 255 255 / 0.72);
    box-shadow:
      0 8px 32px rgb(110 82 60 / 0.12),
      0 1px 0 rgb(255 255 255 / 0.9);
  }

  .schedule-event-card__icon {
    display: inline-flex;
    margin-bottom: 1.05rem;
    color: #6e523c;
  }

  .schedule-event-card__icon :global(svg) {
    width: clamp(2.35rem, 5vw, 2.75rem);
    height: clamp(2.35rem, 5vw, 2.75rem);
  }

  .schedule-event-card__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-weight: 400;
    line-height: 1.2;
    color: #3a2e26;
  }

  .schedule-event-card__time {
    margin: 0.7rem 0 0;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6e523c;
  }

  .schedule-event-card__venue {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: rgb(58 46 38 / 0.92);
  }

  .schedule-event-card__location,
  .schedule-event-card__notes {
    margin: 0.35rem 0 0;
    font-size: 0.75rem;
    line-height: 1.7;
    color: rgb(58 46 38 / 0.88);
  }

  .schedule-event-card__location {
    font-style: italic;
    font-weight: 600;
  }

  .schedule-event-card__location-link {
    color: inherit;
    font-style: inherit;
    text-decoration: underline;
    text-decoration-color: rgb(91 66 50 / 0.5);
    text-underline-offset: 0.14em;
  }

  .schedule-event-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.45rem;
    justify-content: center;
    align-items: center;
  }

  /* On wide screens the calendar group is transparent so all pills flow inline */
  .schedule-event-card__calendar {
    display: contents;
  }

  .schedule-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    box-sizing: border-box;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgb(110 82 60 / 0.28);
    border-radius: 9999px;
    background: rgb(110 82 60 / 0.1);
    color: #4e3b2c;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .schedule-action--primary {
    background: #6e523c;
    border-color: #6e523c;
    color: #fff;
  }

  .schedule-action__icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .schedule-action:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgb(110 82 60 / 0.28);
  }

  @media (hover: hover) and (pointer: fine) {
    .schedule-action:hover {
      background: #6e523c;
      color: #fff;
      border-color: #6e523c;
      transform: translateY(-1px);
      box-shadow: 0 8px 20px rgb(110 82 60 / 0.2);
    }

    .schedule-action--primary:hover {
      background: #5b4232;
      border-color: #5b4232;
    }
  }

  /* Church Wedding + Reception side-by-side on desktop */
  @media (min-width: 640px) {
    #church-wedding .schedule-day__events {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
      justify-items: stretch;
    }

    #church-wedding .schedule-day__events .schedule-event-card {
      max-width: none;
      width: 100%;
    }

    #church-wedding .schedule-day__events .schedule-event-card:last-child {
      grid-column: 1 / -1;
      max-width: 34rem;
      margin-inline: auto;
      width: 100%;
    }
  }

  /* Primary directions button + two-up calendar row on small screens */
  @media (max-width: 32rem) {
    .schedule-event-card__actions {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.6rem;
      width: 100%;
      margin-inline: auto;
    }

    .schedule-action {
      gap: 0.5rem;
      padding: 0.78rem 1.05rem;
      border-radius: 0.85rem;
      font-size: 0.72rem;
    }

    .schedule-action--primary {
      width: 100%;
    }

    .schedule-event-card__calendar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      width: 100%;
    }

    .schedule-action__icon {
      width: 1.05rem;
      height: 1.05rem;
    }
  }
</style>
