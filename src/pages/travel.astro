---
import ComingSoonNotice from "@/components/ComingSoonNotice.astro";
import TravelContent from "@/components/travel/TravelContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { coupleNames, event } from "@/config/event";
import { siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "Travel";
const description =
	`Travel information for ${coupleNames}’s wedding: Lagos and Owerri flights, hotel options in Lagos and Umuahia, visa guidance for international guests, and coordinated ground transportation.`;
const title = `${pageTitle} · ${siteTitleSuffix}`;
const canonicalHref = new URL("/travel", Astro.url.origin).href;
---

<BaseLayout
	title={title}
	description={description}
	canonicalHref={canonicalHref}
	loader={{ kind: "curtain", title: "Travel", photo: "/assets/loaders/travel.webp" }}
>
	{
		event.comingSoon.includes("travel") ? (
			<ComingSoonNotice
				eyebrow="Travel"
				title="Travel & Stay"
				message="We're putting together flights, hotels and getting-around tips for Owerri. Check back soon."
			/>
		) : (
			<TravelContent />
		)
	}
</BaseLayout>
