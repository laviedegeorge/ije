---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  coupleFullNames,
  event,
  isPageEnabled,
} from "@/config/event";
import {
  homePageContent,
  navItems,
  siteTitleSuffix,
} from "@/data/site-nav";

const title = `${siteTitleSuffix}`;
const description = `Wedding details for ${coupleFullNames}, including celebration dates, venue highlights, and RSVP access.`;
// Alternates casual (brown/white: 1, 3, 6, 7, 8) and corporate (black: 2, 4, 5)
// photos. There are fewer corporate shots, so 2 and 4 appear twice.
const couplePhotoNumbers = [1, 2, 3, 4, 6, 5, 7, 2, 8, 4];
// The marquee needs at least ~6 photos to fill wide screens; repeat the set if there are fewer.
const marqueePhotoNumbers = Array.from(
  { length: Math.max(6, couplePhotoNumbers.length) },
  (_, i) => couplePhotoNumbers[i % couplePhotoNumbers.length],
);
const coupleMarqueeImages = marqueePhotoNumbers.map((photoNumber) => ({
  src: `/assets/couple/${photoNumber}.webp`,
  alt: `${coupleFullNames} portrait ${photoNumber}`,
}));

const quickLinks = navItems
  .filter((n) => n.target === "_self")
  .slice(0, 4);
---

<BaseLayout
  title={title}
  description={description}
  loader={{ kind: "welcome", photo: "/assets/loaders/welcome.webp" }}
>
  <main class="home-page">

    <!-- 1. Full-viewport hero -->
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__bg" aria-hidden="true"></div>
      <div class="home-hero__scrim" aria-hidden="true"></div>
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">{event.dateLabel} · {event.locationLabel}</p>
        <h1 id="home-title" class="home-hero__title">
          <span>{event.partnerOne.firstName}</span>
          <span aria-hidden="true" class="home-hero__amp">&amp;</span>
          <span>{event.partnerTwo.firstName}</span>
        </h1>
        {isPageEnabled("rsvp") ? (
          <a class="home-hero__cta" href={homePageContent.primaryCta.href}>
            {homePageContent.primaryCta.label}
          </a>
        ) : null}
      </div>
      <a class="home-hero__scroll-hint" href="#events" aria-label="Scroll to celebrations">
        <span aria-hidden="true">Scroll</span>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 2v10M2 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </section>

    <!-- 2. Editorial photo marquee -->
    <section class="home-marquee" aria-label="Couple portraits">
      <div class="home-marquee__viewport">
        <ul class="home-marquee__track">
          {
            [...coupleMarqueeImages, ...coupleMarqueeImages].map(
              (image, index) => (
                <li
                  class="home-marquee__item"
                  aria-hidden={index >= coupleMarqueeImages.length}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    width="720"
                    height="900"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </li>
              ),
            )
          }
        </ul>
      </div>
    </section>

    <!-- 3. Celebration events -->
    <section
      class="home-events wrapper"
      id="events"
      aria-labelledby="events-title"
    >
      <div class="home-events__heading" data-reveal>
        <p class="home-events__eyebrow">Celebration Details</p>
        <h2 id="events-title">Our Wedding Celebrations</h2>
      </div>
      <div class="home-events__grid">
        {
          homePageContent.events.map((event, i) => (
            <article class="home-event-card" data-reveal data-delay={String(i + 1)}>
              <p class="home-event-card__date">{event.dateLabel}</p>
              <h3>{event.title}</h3>
              <p class="home-event-card__location">{event.location}</p>
              <a class="home-event-card__link" href={event.href}>
                View schedule
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 4. Explore quick-links -->
    <section class="home-explore wrapper" aria-labelledby="explore-title">
      <p class="home-explore__eyebrow" data-reveal id="explore-title">Explore the Details</p>
      <div class="home-explore__grid">
        {
          quickLinks.map((link, i) => (
            <a
              class="home-explore__card"
              href={link.href}
              data-reveal
              data-delay={String(i + 1)}
            >
              <span class="home-explore__card-label">{link.label}</span>
              <svg class="home-explore__card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ))
        }
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .home-page {
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  /* ─── Hero ─── */

  .home-hero {
    position: relative;
    height: 98svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: clamp(5rem, 10vh, 8rem);
    isolation: isolate;
    overflow: hidden;
  }

  .home-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Vertical focus keeps the couple's faces in frame on wide screens */
    background: url("/assets/couple/hero.webp") center 30% / cover no-repeat;
    animation: home-hero-kenburns 24s ease-in-out forwards;
    will-change: transform;
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Darkens the photo so the white names stay readable: an even base tint,
       extra shade behind the centred text, and a deeper fade at the bottom. */
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 50%,
        rgb(20 12 6 / 0.38) 0%,
        rgb(20 12 6 / 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgb(20 12 6 / 0.42) 0%,
        rgb(20 12 6 / 0.34) 35%,
        rgb(20 12 6 / 0.5) 65%,
        rgb(20 12 6 / 0.78) 100%
      );
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-inline: clamp(1rem, 4vw, 2.25rem);
    width: 100%;
  }

  .home-hero__eyebrow {
    margin: 0 0 1.5rem;
    font-size: clamp(0.62rem, 1.8vw, 0.78rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.78);
  }

  .home-hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: #fff;
  }

  .home-hero__amp {
    font-size: 0.5em;
    opacity: 0.6;
    margin-block: 0.15em;
  }

  .home-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: clamp(2rem, 4vh, 3rem);
    padding: 0.9rem 2.4rem;
    border: 1.5px solid rgb(255 255 255 / 0.65);
    border-radius: 9999px;
    background: transparent;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 220ms ease,
      border-color 220ms ease;
  }

  .home-hero__scroll-hint {
    position: absolute;
    bottom: clamp(1.5rem, 4vh, 2.25rem);
    left: 50%;
    translate: -50% 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    color: rgb(255 255 255 / 0.5);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    animation: home-scroll-bob 2.4s ease-in-out infinite;
    transition: color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-hero__scroll-hint:hover {
      color: rgb(255 255 255 / 0.85);
    }
  }

  @keyframes home-hero-kenburns {
    from { transform: scale(1); }
    to   { transform: scale(1.05); }
  }

  @keyframes home-scroll-bob {
    0%, 100% { translate: -50% 0; }
    50%       { translate: -50% 6px; }
  }

  @media (hover: hover) and (pointer: fine) {
    .home-hero__cta:hover {
      background: rgb(255 255 255 / 0.14);
      border-color: #fff;
    }
  }

  /* ─── Marquee ─── */

  .home-marquee {
    width: 100%;
    overflow: hidden;
  }

  .home-marquee__viewport {
    overflow: hidden;
  }

  .home-marquee__track {
    display: flex;
    gap: 0;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: home-marquee-scroll 38s linear infinite;
  }

  .home-marquee__item {
    flex: 0 0 auto;
    height: clamp(18rem, 38vw, 28rem);
    aspect-ratio: 4 / 5;
  }

  .home-marquee__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  @keyframes home-marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ─── Events ─── */

  .home-events {
    display: grid;
    justify-items: center;
    gap: clamp(2rem, 4vw, 3rem);
    text-align: center;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(2rem, 4vw, 4rem);
  }

  .home-events__heading {
    text-align: center;
    max-width: 54rem;
  }

  .home-events__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(92 74 61 / 0.75);
    margin: 0 0 1.1rem;
  }

  .home-events__heading h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: #3a2e26;
  }

  .home-events__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    width: 100%;
    max-width: min(100%, 68rem);
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .home-events__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  .home-event-card {
    padding: clamp(1.8rem, 4vw, 2.75rem) clamp(1.5rem, 3.5vw, 2.25rem);
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: 1.5rem;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.55) 0%,
      rgb(255 255 255 / 0.28) 100%
    );
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    box-shadow:
      0 8px 32px rgb(110 82 60 / 0.12),
      0 1px 0 rgb(255 255 255 / 0.9);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .home-event-card__date {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6e523c;
  }

  .home-event-card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: #3a2e26;
  }

  .home-event-card__location {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgb(58 46 38 / 0.82);
    flex: 1;
  }

  .home-event-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #6e523c;
    text-decoration: none;
    transition:
      gap 200ms ease,
      color 180ms ease;
  }

  .home-event-card__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgb(110 82 60 / 0.3);
    border-radius: 0.3rem;
    padding-inline: 0.15rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-event-card__link:hover {
      color: #3f2e22;
      gap: 0.55rem;
    }
  }

  /* ─── Explore quick-links ─── */

  .home-explore {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(5rem, 10vw, 8rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .home-explore__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(92 74 61 / 0.75);
    text-align: center;
  }

  /* Flex instead of a fixed grid so any number of cards (pages can be
     switched off in src/config/event.ts) stays centred */
  .home-explore__grid {
    --explore-cols: 2;
    --explore-gap: 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--explore-gap);
    max-width: min(100%, 68rem);
    margin-inline: auto;
    width: 100%;
  }

  .home-explore__grid > .home-explore__card {
    flex: 0 0
      calc((100% - (var(--explore-cols) - 1) * var(--explore-gap)) / var(--explore-cols));
    min-width: 0;
  }

  @media (min-width: 640px) {
    .home-explore__grid {
      --explore-cols: 4;
      --explore-gap: 1.25rem;
    }
  }

  .home-explore__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 2.5vw, 1.35rem);
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 1.25rem;
    background: linear-gradient(
      135deg,
      rgb(255 255 255 / 0.52) 0%,
      rgb(255 255 255 / 0.24) 100%
    );
    backdrop-filter: blur(12px) saturate(120%);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    box-shadow:
      0 6px 24px rgb(110 82 60 / 0.09),
      0 1px 0 rgb(255 255 255 / 0.85);
    text-decoration: none;
    color: #3a2e26;
    transition:
      background 220ms ease,
      box-shadow 220ms ease,
      translate 220ms ease;
  }

  .home-explore__card-label {
    font-size: clamp(0.82rem, 2vw, 0.92rem);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .home-explore__card-arrow {
    flex-shrink: 0;
    color: #6e523c;
    opacity: 0.7;
    transition: translate 220ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-explore__card:hover {
      background: linear-gradient(
        135deg,
        rgb(255 255 255 / 0.68) 0%,
        rgb(255 255 255 / 0.38) 100%
      );
      box-shadow:
        0 12px 40px rgb(110 82 60 / 0.13),
        0 1px 0 rgb(255 255 255 / 0.9);
      translate: 0 -2px;
    }

    .home-explore__card:hover .home-explore__card-arrow {
      translate: 3px 0;
      opacity: 1;
    }
  }

  /* ─── Reduced motion ─── */

  @media (prefers-reduced-motion: reduce) {
    .home-hero__bg {
      animation: none;
    }

    .home-hero__scroll-hint {
      animation: none;
    }

    .home-marquee__track {
      animation: none;
    }

    .home-marquee__viewport {
      overflow-x: auto;
    }
  }
</style>
