---
import FaqContent from "@/components/faq/FaqContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { coupleNames } from "@/config/event";
import { siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "FAQ";
const description =
	`Short answers to common questions about ${coupleNames}’s wedding in Owerri: dates, venues, dress code, colours of the day, asoebi, RSVP and registry.`;
const title = `${pageTitle} · ${siteTitleSuffix}`;
const canonicalHref = new URL("/faq", Astro.url.origin).href;
---

<BaseLayout
	title={title}
	description={description}
	canonicalHref={canonicalHref}
	loader={{ kind: "curtain", title: "FAQs", photo: "/assets/loaders/faq.webp" }}
>
	<FaqContent />
</BaseLayout>
