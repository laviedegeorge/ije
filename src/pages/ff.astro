---
import Analytics from "@vercel/analytics/astro";
import GardenExperience from "@/components/garden/GardenExperience.astro";
import { coupleNames } from "@/config/event";
import { ffInviteContent } from "@/data/ffInvite";
import { invitePreviewImage } from "@/data/shareInvite";
import { siteTitleSuffix } from "@/data/site-nav";

// Nonye's personal invitation. A full-screen 3D page, so it skips the site header and footer.
const title = `For my FF · ${siteTitleSuffix}`;
const description = `A letter from ${ffInviteContent.from}, for ${ffInviteContent.guestName}.`;
const ogImage = new URL(invitePreviewImage.src, Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#241a14" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={coupleNames} />
    <meta property="og:title" content="For my FF" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={invitePreviewImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Figtree:wght@400;500;600;700&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
    <Analytics />
    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #241a14;
      }
      :root {
        --garden-display: "Bodoni Moda";
        --garden-body: "Figtree";
        --garden-script: "Pinyon Script";
      }
    </style>
  </head>
  <body>
    <GardenExperience content={ffInviteContent} />
  </body>
</html>
